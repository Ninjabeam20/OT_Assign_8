+
+// Resolve only originally-writable user pages. Text and guard pages stay protected.
+uint64 cowfault(pagetable_t pt, uint64 va) {
+  va = PGROUNDDOWN(va);
+  if (va >= MAXVA) return 0;
+  pte_t *pte = walk(pt, va, 0);
+  if (!pte || (*pte & (PTE_V|PTE_U|PTE_COW)) != (PTE_V|PTE_U|PTE_COW)) return 0;
+  uint64 old = PTE2PA(*pte);
+  char *mem = kalloc();
+  if (!mem) return 0;
+  memmove(mem, (void*)old, PGSIZE);
+  *pte = PA2PTE(mem) | ((PTE_FLAGS(*pte) | PTE_W) & ~PTE_COW);
+  sfence_vma();
+  kfree((void*)old);
+  return (uint64)mem;
+}
